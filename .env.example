# ─── Neon Postgres ────────────────────────────────────────────────────────────
# Copy nguyên khối "Environment variables" mà Neon Console sinh ra (Connect → .env).
# DATABASE_URL:          chuỗi CÓ pooling (hostname chứa "-pooler") — app dùng.
# DATABASE_URL_UNPOOLED: chuỗi KHÔNG pooling — prisma migrate dùng.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ─── Kho ảnh (Vercel Blob) ────────────────────────────────────────────────────
# Vercel → Storage → Create → Blob → Connect to project: biến này tự có trên Vercel.
# Chạy local: copy token từ Vercel → Settings → Environment Variables vào đây.
BLOB_READ_WRITE_TOKEN=

# ─── Naver Static Map (tùy chọn) ─────────────────────────────────────────────
# Naver Map không cho nhúng iframe; có 2 biến này thì chi nhánh có toạ độ sẽ hiện ảnh bản đồ
# Naver (proxy qua /api/map/:id, secret không ra trình duyệt). Lấy ở NCP Console →
# Services → Maps → Application (bật Static Map). Để trống = chỉ nút "Chỉ đường" mở Naver Map.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# Đổi nếu NCP báo host khác (tài khoản cũ dùng https://naveropenapi.apigw.ntruss.com/map-static/v2/raster)
# NAVER_MAP_STATIC_URL=https://maps.apigw.ntruss.com/map-static/v2/raster

# ─── Auth quản trị ────────────────────────────────────────────────────────────
# Một mật khẩu duy nhất (không phân role) + secret ký JWT (≥ 32 ký tự: openssl rand -base64 48).
ADMIN_PASSWORD="doi-mat-khau-nay"
AUTH_SECRET="chuoi-ngau-nhien-dai-toi-thieu-32-ky-tu-doi-truoc-khi-deploy"
